# Copia aquest fitxer com a ".env" al mateix directori i omple els
# valors reals. El .env real MAI es puja a git (està al .gitignore).

# Connexió al teu Postgres natiu (fora de Docker). Crea l'usuari i la
# base de dades tu mateix — veure el README de l'arrel del projecte.
DATABASE_URL=postgresql://usuari:contrasenya@localhost:5432/tfgdb

# Clau per signar els JWT de sessió/stream. Posa'n una de llarga i
# aleatòria, no la reutilitzis d'un altre projecte.
SECRET_KEY=canvia-aquesta-clau-per-una-de-segura-i-llarga

# URL accessible des del NAVEGADOR (no des de dins de Docker) per
# reproduir l'HLS que serveix el mediaserver.
STREAM_BASE_URL=http://localhost:8888

# SMTP per als correus de càmeres acceptades/denegades. Amb Gmail cal
# una "contrasenya d'aplicació", no la contrasenya normal del compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=el-teu-correu@gmail.com
SMTP_PASSWORD=la-teva-contrasenya-d-aplicacio
SMTP_FROM=el-teu-correu@gmail.com

# Host/port RTSP que s'inclouen a l'email de credencials d'una càmera
# acceptada (per exemples de com publicar-hi des de fora).
CLOUD_HOST=localhost
CLOUD_RTSP_PORT=8554

# MinIO — opcional. Per defecte ja apunta al servei "minio" que aixeca
# docker-compose.yml amb aquestes mateixes credencials, així que només
# cal descomentar-ho si vols fer servir un MinIO diferent.
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
# MINIO_BUCKET=detections
